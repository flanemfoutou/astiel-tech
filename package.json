{
  "name": "astiell-services-api",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/api dev",
    "dev:client": "cd apps/client && bun run --no-workspaces dev",
    "build": "bun run --cwd apps/api build",
    "build:client": "cd apps/client && bun run --no-workspaces build",
    "start": "bun run --cwd apps/api start",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:push": "bun run --cwd packages/db push",
    "db:studio": "bun run --cwd packages/db studio",
    "typecheck": "tsc --build --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2"
  }
}